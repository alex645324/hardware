#include <LiquidCrystal.h>

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);
const int backlightPin = 6;
const int xPin = A0;
const int yPin = A1;

int lastDirection = -1;

void setup() {
  pinMode(backlightPin, OUTPUT);
  analogWrite(backlightPin, 80);
  lcd.begin(16, 2);
}

void loop() {
  int x = analogRead(xPin);
  int y = analogRead(yPin);

  int direction = 0;
  if (x < 300) direction = 1;
  else if (x > 700) direction = 2;
  else if (y < 300) direction = 3;
  else if (y > 700) direction = 4;

  if (direction != lastDirection) {
    lcd.clear();
    lcd.setCursor(0, 0);
    switch (direction) {
      case 1: lcd.print("A"); break;
      case 2: lcd.print("your"); break;
      case 3: lcd.print("Pussy"); break;
      case 4: break;
    }
    lastDirection = direction;
  }

  delay(50);
}
